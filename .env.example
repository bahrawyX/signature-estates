# Signature Estates — Environment Variables
# Copy this file to `.env.local` and fill in real values.

# ── Supabase ──────────────────────────────────────────────────────────────
# Public URL + anon key — safe to expose to the browser, used for read-only
# access through the public website.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-only, used by /api/admin/* routes for writes.
# NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ── Admin panel ───────────────────────────────────────────────────────────
# Password to access /admin. Use something strong in production.
ADMIN_PASSWORD=your-chosen-password

# Secret used to sign admin session cookies (HMAC-SHA256). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=random-64-character-string
