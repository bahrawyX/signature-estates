# Signature Estates — Environment Variables
# Copy this file to `.env.local` and fill in real values.

# Password to access the /admin panel.
# Use something strong in production. Default for first-run convenience:
ADMIN_PASSWORD=Estates2024!

# Secret used to sign admin session cookies (HMAC-SHA256).
# Generate a long random string in production. Example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-me-with-a-long-random-string
